---
// Card for one feed item (src/lib/feed.js): a post or a Price Atlas.
// Badge = category, its own link to /topic/<key>/ (the title link's ::after makes the rest of the card clickable). showType: also name the menu section (used on /tag/ pages, which mix sections).
import { TOPICS, TAGS, TYPES } from '../data/site.js';
import { srcset } from '../lib/thumb.js';
const { item: i, showType = false } = Astro.props;
---
<article class="shot post-card" data-topic={i.topic} data-news={i.news?.join(' ')}>
  <div class="shot__img"><img src={i.cover} srcset={srcset(i.cover)} sizes="(max-width: 768px) 100vw, 33vw" width={i.coverW} height={i.coverH} loading="lazy" alt="" style={`aspect-ratio:${i.coverW}/${i.coverH}`} /></div>
  <div class="shot__body">
    {TOPICS[i.topic]
      ? <a class="type-badge" href={`/topic/${i.topic}/`}>{showType && `${TYPES[i.type].name} · `}{TOPICS[i.topic].name}</a>
      : <span class="type-badge">{showType && `${TYPES[i.type].name} · `}{i.topic}</span>}
    <a class="shot__label post-card__link" href={i.href}>{i.title}</a>
    {i.reading && <span class="reading">วัดจริง {i.reading}</span>}
    <span class="meta">{i.sub}</span>
    {i.tags?.length > 0 && <span class="tags-line">{i.tags.map((t) => `#${TAGS[t]}`).join(' ')}</span>}
  </div>
</article>
