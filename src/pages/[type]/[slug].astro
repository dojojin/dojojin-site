---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { TYPES, TOPICS, TAGS, PROFILE } from '../../data/site.js';
import { srcset } from '../../lib/thumb.js';

export async function getStaticPaths() {
  const all = await getCollection('posts', (p) => !p.data.draft);
  return all.map((entry) => {
    const [type, slug] = entry.id.split('/');
    return { params: { type, slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const toc = headings.filter((h) => h.depth === 2);
const url = new URL(Astro.url.pathname, Astro.site).href;
const abs = (u) => new URL(u, Astro.site).href;
const schema = [
  {
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    image: abs(d.cover),
    datePublished: d.date.toISOString().slice(0, 10),
    inLanguage: 'th',
    url,
    mainEntityOfPage: url,
    keywords: d.tags.map((t) => TAGS[t]).join(', '),
    articleSection: `${TYPES[d.type].name} · ${TOPICS[d.topic].name}`,
    author: d.pr ? { '@type': 'Organization', name: d.pr } : { '@type': 'Person', name: PROFILE.name, alternateName: PROFILE.handle, url: abs('/') },
    publisher: { '@type': 'Person', name: PROFILE.name },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: TYPES[d.type].name, item: abs(`/${d.type}/`) },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---
<Base title={d.title} description={d.description} image={d.cover} active={d.type} ogType="article" schema={schema}>
  <section class="hero">
    <div class="wrap">
      <div class="hero__text">
        <nav class="crumbs" aria-label="breadcrumb"><a href={`/${d.type}/`}>{TYPES[d.type].name}</a> / <a href={`/topic/${d.topic}/`}>{TOPICS[d.topic].name}</a></nav>
        <span class="kicker">{d.kicker}</span>
        <h1>{d.title}</h1>
        <p class="lead">{d.lead}</p>
        <p class="meta">{d.meta} · {d.date.toLocaleDateString('th-TH', { dateStyle: 'long' })}<span data-views hidden> · เข้าชม <b></b> ครั้ง</span></p>
        {d.tags.length > 0 && <ul class="taglinks" aria-label="tags">{d.tags.map((t) => <li><a href={`/tag/${t}/`}>#{TAGS[t]}</a></li>)}</ul>}
      </div>
      <figure class="hero__media"><img src={d.cover} srcset={srcset(d.cover)} sizes="(max-width: 768px) 100vw, 45vw" width="1600" height="1200" alt={d.coverAlt} /></figure>
    </div>
  </section>

  <div class="wrap layout">
    <nav class="toc" aria-label="สารบัญ">
      <b>ในบทความนี้</b>
      <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
    </nav>
    <main class="content"><Content /></main>
  </div>

  <div class="wrap source">
    {d.pr ? <>ข่าวประชาสัมพันธ์จาก {d.pr} · เนื้อหาและภาพจากผู้ส่งข่าว</> : d.sourceName ? <>ที่มา: <a href={d.sourceUrl} rel="noopener">{d.sourceName}</a> · เรียบเรียงโดย DOJOJIN.TECH</> : <>{d.sourceUrl && <>โพสต์ต้นฉบับ: <a href={d.sourceUrl} rel="noopener">Facebook · Dojo-mAn Fotographer</a> · </>}ภาพทั้งหมด © Dojo-mAn Photographer</>}
  </div>
</Base>
