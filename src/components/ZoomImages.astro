---
// Text-heavy pictures in a post (infographics `.split-fig`, screenshots `.news-fig--zoom`) get a magnifier button.
// It opens a full-screen <dialog>: fit to screen; click/tap the picture to view at full size (scroll/pinch to move);
// close with the ✕ button, Esc (native dialog), or a click on the dark backdrop.
---
<dialog class="zoomer" aria-label="ขยายภาพ">
  <button class="zoomer__close" type="button" aria-label="ปิด">✕</button>
  <div class="zoomer__stage"><img alt="" /></div>
</dialog>
<script>
  const dlg = document.querySelector('.zoomer');
  const img = dlg.querySelector('img');
  const stage = dlg.querySelector('.zoomer__stage');
  const glass = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5M11 8v6M8 11h6"/></svg>';
  document.querySelectorAll('main .split-fig img, main .news-fig--zoom img').forEach((pic) => {
    const box = pic.parentElement; box.classList.add('zoomable');
    const b = document.createElement('button');
    b.type = 'button'; b.className = 'zoom-btn'; b.setAttribute('aria-label', 'ขยายภาพ'); b.innerHTML = glass;
    const open = () => { img.src = pic.currentSrc || pic.src; img.alt = pic.alt; stage.classList.remove('is-full'); dlg.showModal(); };
    b.addEventListener('click', open); pic.addEventListener('click', open);
    box.append(b);
  });
  img.addEventListener('click', (e) => { e.stopPropagation(); stage.classList.toggle('is-full'); });
  dlg.querySelector('.zoomer__close').addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg || e.target === stage) dlg.close(); });
</script>
