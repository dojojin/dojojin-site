---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, TYPES, PROFILE } from '../data/site.js';
import { getFeed } from '../lib/feed.js';
import { srcset } from '../lib/thumb.js';

const feed = await getFeed();
// One section per menu type, same order as the menu; empty types are skipped.
const sections = Object.entries(TYPES).map(([type, t]) => ({ type, t, items: feed.filter((i) => i.type === type) })).filter((s) => s.items.length);
// Home shows 3 cards per type, mixed across categories: newest of each topic first (feed is newest-first),
// then the rest by date — so one busy category (e.g. chargers) can't fill the whole row.
const mixed = (items, n = 3) => {
  const seen = new Set(), picks = [];
  for (const i of items) if (!seen.has(i.topic)) { seen.add(i.topic); picks.push(i); }
  return [...picks, ...items.filter((i) => !picks.includes(i))].slice(0, n).sort((a, b) => b.date - a.date);
};
// The 4 blocks at the top: what the site offers, one block each (newest post big + 3 more as a list).
const HUB = ['news', 'review', 'knowledge'];   // top row: 3 blocks
const PAIR = ['eat', 'data'];                    // second row: 2 blocks
const block = (type) => {
  const items = feed.filter((i) => i.type === type);
  const picks = type === 'review' ? mixed(items, 4) : items.slice(0, 4);
  return { type, t: TYPES[type], count: items.length, lead: picks[0], rest: picks.slice(1) };
};
const hub = HUB.filter((type) => TYPES[type]).map(block).filter((b) => b.lead);
const pair = PAIR.filter((type) => TYPES[type]).map(block).filter((b) => b.lead);
const others = sections.filter((s) => !HUB.includes(s.type) && !PAIR.includes(s.type));
const day = (d) => d.toLocaleDateString('th-TH', { day: 'numeric', month: 'short', year: '2-digit' });
// Spotlight (right of the hero): the newest post is rendered here; the rest come from /spot.json after load.
const f0 = feed[0];
const first = { href: f0.href, title: f0.title, cover: f0.cover, kind: TYPES[f0.type]?.name ?? '', sub: f0.sub ?? '' };
---
<Base active="home">
  <section class="hero me">
    <div class="wrap me__grid">
      <div class="me__text">
        <p class="me__who"><img src="/logo-80.webp" width="40" height="40" alt="" /><span>รีวิว · ความรู้ · ข่าว · ท่องเที่ยว</span></p>
        <h1 class="me__title"><span>ซื้อจริง ใช้จริง ไปจริง</span> <span>แล้วมาเล่าให้ฟัง</span></h1>
        <p class="lead">ผม ปอ Dojo-mAn ชอบถ่ายรูป ชอบเที่ยว ชอบลองของใหม่ ๆ ที่นี่มีรีวิวของที่ซื้อมาใช้เอง ร้านอร่อยที่ไปจ่ายเงินเอง เรื่องไอทีที่เล่าให้เข้าใจง่าย และข่าวที่มีประโยชน์ที่อยากบอกต่อครับ</p>
        <ul class="me__promise">
          <li><b>ซื้อจริง ใช้จริง</b><span>ใช้งานจริงก่อนเขียนทุกรีวิว</span></li>
          <li><b>วัดเอง</b><span>หัวชาร์จวัดด้วยมิเตอร์ ทุกตัวเลขบอกที่มา</span></li>
          <li><b>รีวิวถ่ายเองทุกรูป</b><span>Dojo-mAn Fotographer</span></li>
          <li><b>ไปเอง จ่ายเอง</b><span>ร้านอาหารและคาเฟ่</span></li>
          <li><b>คัดข่าวที่มีประโยชน์</b><span>ข่าวที่ผมสนใจ บอกแหล่งที่มาทุกข่าว</span></li>
          <li><b>เล่าให้เข้าใจง่าย</b><span>เรื่องเทคนิคอธิบายแบบภาษาคนทั่วไป</span></li>
        </ul>
        <nav class="me__go" aria-label="หมวด">
          {Object.entries(TYPES).map(([type, t]) => (
            <a href={`/${type}/`}>{t.name} <span>{feed.filter((i) => i.type === type).length}</span></a>
          ))}
        </nav>
      </div>
      <aside class="me__side spot" aria-roledescription="carousel" aria-label="บทความแนะนำ สุ่มจากทั้งเว็บ" data-spot>
        <a class="spot__card" href={first.href} aria-live="polite">
          <img src={first.cover} srcset={srcset(first.cover)} sizes="(max-width: 768px) 100vw, 36vw" width="1600" height="1200" alt="" />
          <span class="spot__kind">{first.kind}</span>
          <b class="spot__title">{first.title}</b>
          <span class="spot__sub">{first.sub}</span>
        </a>
        <div class="spot__nav">
          <span class="meta">สุ่มอ่านเรื่องอื่น</span>
          <button class="btn-icon" type="button" data-spot-prev aria-label="เรื่องก่อนหน้า"><svg class="icon" aria-hidden="true"><use href="#icon-prev" /></svg></button>
          <button class="btn-icon" type="button" data-spot-pause aria-label="หยุดเลื่อนอัตโนมัติ" aria-pressed="false"><span aria-hidden="true">❚❚</span></button>
          <button class="btn-icon" type="button" data-spot-next aria-label="เรื่องถัดไป"><svg class="icon" aria-hidden="true"><use href="#icon-next" /></svg></button>
        </div>
      </aside>
    </div>
  </section>

  <main class="wrap layout" style="grid-template-columns:1fr">
    <div class="content">
      <section class="section hub hub--three" aria-label="เว็บนี้มีอะไรบ้าง">
        {hub.map(({ type, t, count, lead, rest }) => (
          <article class="hub__block">
            <div class="section-head">
              <h2>{t.name}</h2>
              <a class="more" href={`/${type}/`}>ดูทั้งหมด ({count}) <svg class="icon" aria-hidden="true"><use href="#icon-next" /></svg></a>
            </div>
            <p class="meta">{t.blurb}</p>
            <a class="hub__lead" href={lead.href}>
              <img src={lead.cover} srcset={srcset(lead.cover)} sizes="(max-width: 768px) 100vw, 45vw" width={lead.coverW} height={lead.coverH} loading="lazy" alt="" />
              <b>{lead.title}</b>
              <span class="meta">{day(lead.date)}</span>
            </a>
            <ul class="hub__list">
              {rest.map((i) => <li><a href={i.href}>{i.title}</a><span class="meta">{day(i.date)}</span></li>)}
            </ul>
          </article>
        ))}
      </section>

      <section class="section hub hub--pair" aria-label="ท่องเที่ยว และข้อมูล">
        {pair.map(({ type, t, count, lead, rest }) => (
          <article class="hub__block">
            <div class="section-head">
              <h2>{t.name}</h2>
              <a class="more" href={`/${type}/`}>ดูทั้งหมด ({count}) <svg class="icon" aria-hidden="true"><use href="#icon-next" /></svg></a>
            </div>
            <p class="meta">{t.blurb}</p>
            <a class="hub__lead" href={lead.href}>
              <img src={lead.cover} srcset={srcset(lead.cover)} sizes="(max-width: 768px) 100vw, 45vw" width={lead.coverW} height={lead.coverH} loading="lazy" alt="" />
              <b>{lead.title}</b>
              <span class="meta">{day(lead.date)}</span>
            </a>
            <ul class="hub__list">
              {rest.map((i) => <li><a href={i.href}>{i.title}</a><span class="meta">{day(i.date)}</span></li>)}
            </ul>
          </article>
        ))}
      </section>



      {others.map(({ type, t, items }) => (
        <section class="section">
          <div class="section-head">
            <h2>{t.name}</h2>
            <a class="more" href={`/${type}/`}>ดูทั้งหมด ({items.length}) <svg class="icon" aria-hidden="true"><use href="#icon-next" /></svg></a>
          </div>
          <p class="meta" style="margin:0 0 var(--space-2)">{t.blurb}</p>
          <div class="gallery">{mixed(items).map((i) => <PostCard item={i} />)}</div>
        </section>
      ))}

      <section class="section me-more" aria-label="เกี่ยวกับผม">
        <div class="popular" data-popular hidden>
          <b>คนอ่านเยอะสุด</b>
          <ol></ol>
        </div>
        <div>
          <p class="me__about">{PROFILE.intro}</p>
          <ul class="socials">
            <li><a href="/projects/">ผลงานของผม</a></li>
            <li><a href={`mailto:${PROFILE.email}`}>ติดต่อ</a></li>
            <li><a href={PROFILE.socials.facebook} rel="noopener">Facebook</a></li>
          </ul>
        </div>
      </section>

    </div>
  </main>
</Base>

<script>
  // Spotlight: shuffle every post, show one at a time; auto-advance every 6 s (not with reduced motion),
  // paused while hovered/focused or by the pause button.
  const box = document.querySelector('[data-spot]');
  if (box) {
    let list = [];
    const card = box.querySelector('.spot__card'), img = card.querySelector('img');
    const small = (src) => (/^\/media\/.*\.jpg$/.test(src) ? `${src.replace(/\.jpg$/, '.800.webp')} 800w, ${src} 1600w` : '');
    let n = 0, timer = 0, hold = false, stopped = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Warm the next image at the size this screen will actually use (not the 1600px JPEG on phones).
    const warm = (src) => { const w = new Image(); w.sizes = img.sizes; if (small(src)) w.srcset = small(src); w.src = src; };
    const show = (k) => {
      if (list.length < 2) return;
      n = (k + list.length) % list.length; const it = list[n];
      card.classList.remove('is-in'); void card.offsetWidth; card.classList.add('is-in');
      card.href = it.href; img.src = it.cover; img.srcset = small(it.cover);
      card.querySelector('.spot__kind').textContent = it.kind;
      card.querySelector('.spot__title').textContent = it.title;
      card.querySelector('.spot__sub').textContent = it.sub;
      warm(list[(n + 1) % list.length].cover);
    };
    const tick = () => { clearInterval(timer); if (!stopped) timer = setInterval(() => { if (!hold) show(n + 1); }, 6000); };
    const pause = box.querySelector('[data-spot-pause]');
    const setPause = (v) => { stopped = v; pause.setAttribute('aria-pressed', String(v)); pause.setAttribute('aria-label', v ? 'เลื่อนอัตโนมัติต่อ' : 'หยุดเลื่อนอัตโนมัติ'); pause.firstElementChild.textContent = v ? '▶' : '❚❚'; tick(); };
    box.querySelector('[data-spot-prev]').addEventListener('click', () => { show(n - 1); tick(); });
    box.querySelector('[data-spot-next]').addEventListener('click', () => { show(n + 1); tick(); });
    pause.addEventListener('click', () => setPause(!stopped));
    box.addEventListener('mouseenter', () => (hold = true)); box.addEventListener('mouseleave', () => (hold = false));
    box.addEventListener('focusin', () => (hold = true)); box.addEventListener('focusout', () => (hold = false));
    // The list arrives after load (kept out of the HTML). Keep the server-rendered first story; shuffle the rest.
    addEventListener('load', () => (window.spotData ??= fetch('/spot.json').then((r) => r.json())).then((d) => {
      list = d.spot;
      for (let i = list.length - 1; i > 1; i--) { const j = 1 + Math.floor(Math.random() * i); [list[i], list[j]] = [list[j], list[i]]; }
      if (list.length > 1) warm(list[1].cover);
    }).catch(() => {}), { once: true });
    setPause(stopped);
  }
</script>
