#!/usr/bin/env bash
# Gate: a news post dated 2026-11-27 or later cannot be committed unless check-post.py prints PASS for it.
# Applies to every agent and person committing in this repo. Installed with: git config core.hooksPath scripts/hooks
# Bypass (owner only, on purpose): git commit --no-verify
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"; cd "$ROOT"
CUTOFF="2026-11-27"
slugs=()
while IFS= read -r f; do
  [[ "$f" == src/content/posts/news/*.mdx ]] || continue
  [ -f "$f" ] || continue
  d="$(grep -m1 '^date:' "$f" | grep -o '[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}' | head -1)"
  [[ -n "$d" && ! "$d" < "$CUTOFF" ]] && slugs+=("$(basename "$f" .mdx)")
done < <(git diff --cached --name-only --diff-filter=AM)
# a staged cover or body image also re-checks its post
while IFS= read -r f; do
  s="$(echo "$f" | sed -n 's|^public/media/posts/news/\([^/]*\)/.*|\1|p')"
  [ -n "$s" ] && [ -f "src/content/posts/news/$s.mdx" ] || continue
  d="$(grep -m1 '^date:' "src/content/posts/news/$s.mdx" | grep -o '[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}' | head -1)"
  [[ -n "$d" && ! "$d" < "$CUTOFF" ]] && slugs+=("$s")
done < <(git diff --cached --name-only --diff-filter=AM)
[ "${#slugs[@]}" -eq 0 ] && exit 0
mapfile -t slugs < <(printf '%s\n' "${slugs[@]}" | sort -u)
echo "pre-commit: ตรวจข่าว ${#slugs[@]} เรื่องด้วย scripts/content/check-post.py"
if ! python3 scripts/content/check-post.py "${slugs[@]}"; then
  echo
  echo "✗ commit ถูกหยุด: ข่าวข้างบนยังไม่ผ่านด่านตรวจ แก้ตาม .claude/skills/dojojin-news/SKILL.md แล้ว commit ใหม่"
  echo "  (เจ้าของเท่านั้นที่ข้ามได้ด้วย git commit --no-verify)"
  exit 1
fi
