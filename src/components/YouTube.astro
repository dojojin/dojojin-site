---
// Click-to-play YouTube: shows a local 16:9 thumbnail (public/media/... yt-<id>.jpg, + .800.webp via thumbs.py);
// the youtube-nocookie iframe loads only after a tap, so pages stay fast (no YouTube JS on load).
// props: id (YouTube video id), title, thumb (path to the local jpg), caption (optional HTML under the video)
import { srcset } from '../lib/thumb.js';
const { id, title, thumb, caption } = Astro.props;
---
<figure class="yt">
  <button class="yt__frame" type="button" data-yt={id} data-title={title} aria-label={`เล่นวิดีโอ: ${title}`}>
    <img src={thumb} srcset={srcset(thumb)} sizes="(max-width: 768px) 100vw, 480px" width="1280" height="720" loading="lazy" alt="" />
    <span class="yt__play" aria-hidden="true"></span>
  </button>
  <figcaption><b>{title}</b>{caption && <> · <Fragment set:html={caption} /></>} · <a href={`https://www.youtube.com/watch?v=${id}`} rel="noopener">ดูใน YouTube</a></figcaption>
</figure>

<script>
document.addEventListener('click', (e) => {
  const btn = e.target instanceof Element && e.target.closest('button[data-yt]');
  if (!btn) return;
  const f = document.createElement('iframe');
  f.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1&rel=0`;
  f.title = btn.dataset.title;
  f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
  f.allowFullscreen = true;
  const box = document.createElement('div');
  box.className = 'yt__frame';
  box.append(f);
  btn.replaceWith(box);
});
</script>
