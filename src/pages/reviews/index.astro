---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import { CATEGORIES } from '../../data/site.js';

const all = (await getCollection('reviews', (r) => !r.data.draft)).sort((a, b) => b.data.date - a.data.date);
const count = (k) => all.filter((r) => r.data.category === k).length;
---
<Base title="Reviews" description="รีวิว Charger และหูฟังจาก DOJOJIN.TECH — วัดจริง มีรูปผลวัดทุกตัว" active="reviews">
  <section class="hero">
    <div class="wrap" style="grid-template-columns:1fr">
      <div class="hero__text">
        <span class="kicker">Reviews</span>
        <h1>รีวิว</h1>
      </div>
    </div>
  </section>
  <main class="wrap layout" style="grid-template-columns:1fr">
    <div class="content">
      <ul class="criteria criteria--plain">
        {Object.entries(CATEGORIES).map(([k, v]) => <li><a href={`/reviews/${k}/`}>{v} <span class="meta">({count(k)})</span></a></li>)}
      </ul>
      <h2>ล่าสุด</h2>
      <div class="gallery">{all.map((r) => <ReviewCard review={r} sub={CATEGORIES[r.data.category]} />)}</div>
    </div>
  </main>
</Base>
