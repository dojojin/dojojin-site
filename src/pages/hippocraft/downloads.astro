---
import Base from '../../layouts/Base.astro';

// HippoCraft downloads. Links on upl.dojojin.tech never change (they always serve the newest build);
// only VERSION / DATE below change with a release (source: the owner's release page + README).
const VERSION = '0.18.1-th27.1.b4713';
const DATE = '21 พฤศจิกายน 2569';
const U = (id) => `https://upl.dojojin.tech/pub/fil/${id}`;
const platforms = [
  {
    os: 'Windows 10 / 11',
    tip: 'ดับเบิลคลิก .msi แล้วเลือก Only for me (ไม่ต้องเป็น admin) · ถ้ามีหน้าต่างเตือน กด More info › Run anyway',
    files: [
      ['x64', '.msi', 'PC ทั่วไป', U('ux5v3u46'), true],
      ['x64 Portable', '.zip', 'ไม่ต้องติดตั้ง', U('zozagraa')],
      ['x86 32 บิต', '.msi', 'Windows รุ่นเก่า', U('1xfrmles')],
      ['x86 Portable', '.zip', 'ไม่ต้องติดตั้ง', U('0nmen8mi')],
      ['ARM64', '.msi', 'Surface / Snapdragon', U('oowxgic2')],
      ['ARM64 Portable', '.zip', 'ไม่ต้องติดตั้ง', U('z1mlplfc')],
    ],
  },
  {
    os: 'macOS 11 ขึ้นไป',
    tip: 'Universal: Apple Silicon และ Intel ในไฟล์เดียว · ถ้าเปิดไม่ได้ ไปที่ System Settings › Privacy & Security แล้วกด Open Anyway',
    files: [
      ['Universal', '.dmg', 'แอป', U('6uurxfs9'), true],
      ['CLI', '.zip', 'ใช้ใน Terminal', U('6v7b686e')],
    ],
  },
  {
    os: 'Linux x86_64',
    tip: '.deb สำหรับ Ubuntu 24.04 / Mint 22 / Debian 13 ขึ้นไป · AppImage ใช้ได้กับ glibc 2.39 ขึ้นไป: chmod +x แล้วเปิดได้เลย',
    files: [
      ['AppImage', '', 'ทุก distro', U('ptgs762t'), true],
      ['.deb', '', 'Ubuntu / Mint', U('8pvbdxyu')],
      ['CLI', '.tar.gz', 'สำหรับเซิร์ฟเวอร์', U('48o09gkd')],
      ['AppImage .zsync', '', 'อัปเดตแบบ delta', U('bl6fe65b')],
    ],
  },
];
---
<Base title="ดาวน์โหลด HippoCraft" description={`ดาวน์โหลด HippoCraft ${VERSION} โปรแกรมอ่านและแก้ไข PDF ภาษาไทย สำหรับ Windows, macOS, Linux หรือใช้ผ่านเว็บ pdf.dojojin.tech ไฟล์ไม่ขึ้นคลาวด์`} active="projects" image="/media/projects/hippocraft/icon.png">
  <section class="hero">
    <div class="wrap" style="grid-template-columns:1fr">
      <div class="hero__text">
        <a class="crumbs" href="/projects/hippocraft/">Projects / HippoCraft</a>
        <h1 class="project-title"><img src="/media/projects/hippocraft/icon.png" width="56" height="56" alt="" />ดาวน์โหลด HippoCraft</h1>
        <p class="lead">สาบานว่าจะไม่ทำ PDF ของคุณพัง · โปรแกรมอ่านและแก้ไข PDF ที่เข้าใจภาษาไทยจริง ๆ</p>
        <p class="dl-version"><span>รุ่น <b>{VERSION}</b></span><span class="badge tier-2"><svg class="icon" aria-hidden="true"><use href="#icon-dot" /></svg>Beta</span><span>{DATE}</span></p>
      </div>
    </div>
  </section>

  <main class="wrap layout" style="grid-template-columns:1fr">
    <div class="content dl">
      <section class="dl-web">
        <div>
          <h2>ใช้ผ่านเว็บ ไม่ต้องติดตั้ง</h2>
          <p>ลงทะเบียนก่อนใช้ · ไฟล์ PDF ทำงานในเบราว์เซอร์ของคุณ ไม่ถูกอัปโหลด · รุ่นเว็บยังเป็นรุ่นเก่ากว่า (th26.10v) ฟีเจอร์ใหม่ในรุ่นนี้มีเฉพาะแบบลงเครื่อง</p>
        </div>
        <a class="dl-btn dl-btn--primary" href="https://pdf.dojojin.tech" rel="noopener">เปิด pdf.dojojin.tech</a>
      </section>

      {platforms.map((p) => (
        <section class="dl-os">
          <h2>{p.os}</h2>
          <p class="dl-tip">{p.tip}</p>
          <ul class="dl-list">
            {p.files.map(([name, ext, note, href, main]) => (
              <li><a class={`dl-btn${main ? ' dl-btn--primary' : ''}`} href={href} rel="noopener">
                <b>{name}{ext && <span> {ext}</span>}</b><small>{note}</small>
              </a></li>
            ))}
          </ul>
        </section>
      ))}

      <section class="dl-os">
        <h2>Microsoft Store</h2>
        <p class="dl-tip">ขึ้นแล้ว · ค้นคำว่า HippoCraft ในแอป Microsoft Store แล้วกด Get ฟรี ไม่มีหน้าต่างเตือน ไม่ต้องเป็น admin อัปเดตอัตโนมัติ · Windows 10 (1809) ขึ้นไป และ 11 · x64, x86, ARM64 · รุ่น b4713 · ไม่มีเมนูคลิกขวา "Edit with HippoCraft" ถ้าใช้เมนูนี้ ให้ลง .msi ด้านบนแทน</p>
        <ul class="dl-list">
          <li><a class="dl-btn dl-btn--primary" href="https://apps.microsoft.com/detail/9PLQ0VDJ6NW4" rel="noopener"><b>Microsoft Store</b><small>กด Get ฟรี · x64 · x86 · ARM64</small></a></li>
        </ul>
      </section>

      <section class="dl-notes">
        <h2>ปัญหาที่ยังมีในรุ่นนี้</h2>
        <ul>
          <li>OCR ภาษาอังกฤษยังอ่านผิดบ่อย: หน้าที่วางตะแคง ระบบหมุนอัตโนมัติไม่หมุนให้ · หน้าที่สแกนเอียงได้คำผิด · ตัวเลขอาจผิด (เช่น 45 อ่านเป็น 4) วิธีเลี่ยง: หมุนหน้าให้ตั้งตรงก่อน แล้วตรวจตัวเลขทุกครั้ง · OCR ภาษาไทยไม่โดนปัญหานี้ · มีมาตั้งแต่รุ่นก่อน กำลังแก้อยู่</li>
          <li>กด Enter ในย่อหน้าที่ได้จาก OCR จนข้อความยาวไปชนย่อหน้าถัดไป สองย่อหน้าจะรวมเป็นย่อหน้าเดียว</li>
          <li>ตัวอักษรที่วางทับเส้นในภาพวาด (เช่น ป้ายชื่อบนเส้นผนังในแปลนบ้าน) OCR อาจอ่านหลุดไป</li>
          <li>OCR ภาษาไทยอาจข้ามตัวเลขตัวเดียวในช่องตาราง (เช่น "1" ในคอลัมน์ลำดับ)</li>
          <li>PDF ของหน่วยงานราชการบางไฟล์ที่ทำจาก Word ผ่าน iLovePDF แปลงกลับเป็น Word แล้วหน้าตายังเพี้ยน</li>
          <li>ช่องเลขหน้าและช่องรายการในหน้าต่าง Recognize Text ยังไม่มีชื่อให้โปรแกรมอ่านหน้าจอ (screen reader)</li>
          <li>ย่อหน้าภาษาไทยที่มีคำหนึ่งตัวใหญ่กว่าคำอื่นมาก ทุกบรรทัดจะห่างเท่ากับบรรทัดของคำนั้น</li>
        </ul>
      </section>

      <section class="dl-notes">
        <h2>ข้อมูลเพิ่มเติม</h2>
        <ul>
          <li>ลิงก์ไม่เปลี่ยน เป็นรุ่นล่าสุดเสมอ · ชื่อไฟล์บอกรุ่น เช่น <code>hippocraft-{VERSION}-windows-x64.msi</code> เลขหลัง b ยิ่งมากยิ่งใหม่ · หน้า About ในโปรแกรมบอกเลขเดียวกัน</li>
          <li>ตัวติดตั้งยังไม่ได้เซ็นรับรอง (code-signed) · Windows: ถ้า SmartScreen เตือน กด More info › Run anyway · macOS: System Settings › Privacy &amp; Security › Open Anyway</li>
          <li>ตรวจไฟล์: <a href={U('31uv7uyu')} rel="noopener">SHA256SUMS</a> (ครบทั้ง 12 ไฟล์) · <a href={U('k1i2lpys')} rel="noopener">README / ประวัติรุ่น</a> · <a href={U('yr2s4pe8')} rel="noopener">นโยบายความเป็นส่วนตัว</a></li>
          <li>อยาก build เอง: <a href={U('hacs5a3x')} rel="noopener">คู่มือ build</a></li>
          <li>มีอะไรใหม่ในรุ่นนี้ และงานที่กำลังทำ ดูที่ <a href="/projects/hippocraft/">หน้าโปรเจกต์ HippoCraft</a></li>
          <li>HippoCraft · Dojo-mAn's Edition · พัฒนาต่อจาก <a href="https://github.com/storytold/pdfcraft" rel="noopener">PdfCraft</a> · OCR ภาษาไทยใช้โมเดล OpenThai 2.0 ของ iApp Technology (Apache-2.0) · สัญญาอนุญาต MIT OR Apache-2.0</li>
        </ul>
      </section>
    </div>
  </main>
</Base>
