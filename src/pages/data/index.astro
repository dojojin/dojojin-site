---
import Base from '../../layouts/Base.astro';
import { ATLASES } from '../../data/atlases.js';
const thb = (n) => `฿${n.toLocaleString('en-US')}`;
---
<Base title="Data" description="ชุดข้อมูลอ้างอิงจาก DOJOJIN.TECH — ราคาเปิดตัวในไทยและสเปกระดับชิ้นส่วนของมือถือทุกรุ่น" active="data">
  <section class="hero">
    <div class="wrap" style="grid-template-columns:1fr">
      <div class="hero__text">
        <span class="kicker">Data</span>
        <h1>Price Atlas</h1>
        <p class="lead">ราคาเปิดตัวในไทยของมือถือทุกรุ่นในซีรีส์ ทุกความจุ พร้อมสเปกระดับชิ้นส่วนจากการแกะเครื่อง กราฟราคา และตารางเทียบ</p>
      </div>
    </div>
  </section>

  <main class="wrap layout" style="grid-template-columns:1fr">
    <div class="content">
      <div class="gallery">
        {ATLASES.map((a) => (
          <a class="shot" href={`/data/${a.slug}/`}>
            <div class="shot__img"><img src={`/data/${a.slug}/og.png`} width="1200" height="630" loading="lazy" alt={`ภาพหน้า ${a.short}`} style="aspect-ratio:1200/630" /></div>
            <div class="shot__body">
              <div class="shot__label">{a.short}</div>
              <dl class="readings" style="grid-template-columns:repeat(3,minmax(0,1fr))">
                <div><dt>รุ่น</dt><dd>{a.models}</dd></div>
                <div><dt>ช่วงปี</dt><dd>{a.years}</dd></div>
                <div><dt>ราคาไทย</dt><dd>{thb(a.thbMin)}–{thb(a.thbMax)}</dd></div>
              </dl>
            </div>
          </a>
        ))}
      </div>

      <section class="section" style="margin-top:var(--space-12)">
        <h2>ที่มาของข้อมูลและรูป</h2>
        <div class="split">
          <div class="prose">
            <h3>ข้อมูล</h3>
            <p>ราคาไทยเป็นราคาเปิดตัวรวม VAT 7% จากผู้ผลิตและร้านค้า/สื่อไทย สเปกและรหัสชิ้นส่วนรวบรวมจากผู้ผลิต, iFixit, TechInsights, Kimovil, GSMArena, Wikipedia และแหล่งอื่น ทุกรุ่นมีลิงก์แหล่งที่มาของตัวเอง รหัสชิ้นส่วนที่มีคำว่า “reported”, “likely” หรือ “assumed” ยังไม่ได้รับการยืนยันจากการแกะเครื่อง ดูวิธีเก็บข้อมูลและบันทึกการแก้ไขได้ในส่วน “วิธีเก็บข้อมูล” ของแต่ละหน้า</p>
          </div>
          <div class="prose">
            <h3>รูปเครื่อง</h3>
            <p>รูปเครื่องทุกรูปมาจาก <a href="https://commons.wikimedia.org/" rel="noopener">Wikimedia Commons</a> ภายใต้สัญญาอนุญาตแบบเปิด (CC0, CC BY, CC BY-SA) และถูกย่อขนาดสำหรับหน้าเว็บ แต่ละรูประบุผู้ถ่าย สัญญาอนุญาต และลิงก์ไฟล์ต้นฉบับไว้ใต้รูป และรวมไว้ในส่วน “ที่มาของรูป” ท้ายหน้า รุ่นที่ไม่มีรูปที่ใช้ได้อย่างเสรีจะมีลิงก์ไปหน้าทางการและแกลเลอรีแทน</p>
            <ul>
              {ATLASES.map((a) => <li><a href={`/data/${a.slug}/#credits`}>{a.short}</a>: รูป {a.photos} จาก {a.models} รุ่น</li>)}
            </ul>
          </div>
        </div>
      </section>
    </div>
  </main>
</Base>
