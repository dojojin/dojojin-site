---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { TAGS } from '../../data/site.js';
import { getFeed } from '../../lib/feed.js';

// Only tags in use get a page.
export async function getStaticPaths() {
  const feed = await getFeed();
  return Object.keys(TAGS).filter((t) => feed.some((i) => i.tags.includes(t))).map((tag) => ({ params: { tag } }));
}
const { tag } = Astro.params;
const items = await getFeed(undefined, tag);
---
<Base title={`#${TAGS[tag]}`} description={`บทความที่ติด tag ${TAGS[tag]} บน DOJOJIN.TECH`}>
  <section class="hero">
    <div class="wrap" style="grid-template-columns:1fr">
      <div class="hero__text">
        <nav class="crumbs" aria-label="breadcrumb"><a href="/tag/">Tags</a></nav>
        <h1>#{TAGS[tag]}</h1>
        <p class="lead">{items.length} รายการ จาก Review, ความรู้ และ Data</p>
      </div>
    </div>
  </section>
  <main class="wrap layout" style="grid-template-columns:1fr">
    <div class="content">
      <div class="gallery">{items.map((i) => <PostCard item={i} showType />)}</div>
    </div>
  </main>
</Base>
