---
import Base from '../layouts/Base.astro';
import { getFeed } from '../lib/feed.js';
import { getCollection } from 'astro:content';
import { TYPES } from '../data/site.js';

// Owner's view-count page: reads pageviews/* (public read in firestore.rules) and never adds to them
// (ViewCounter skips /stats/). Not in the menu or sitemap, noindex.
const posts = (await getFeed()).map((i) => ({ href: i.href, title: i.title, type: i.type, date: +i.date }));
const types = Object.entries(TYPES).map(([k, v]) => [k, v.name]);
// Readable names for pages that are not posts (shown under "หน้าอื่น"); anything else shows its path.
const names = {
  '/': 'หน้าแรก', '/projects/': 'หน้ารวม Projects', '/guestbook/': 'Guestbook', '/search/': 'ค้นหา', '/lab/': 'Lab (เว็บเก่า)', '/hippocraft/downloads/': 'HippoCraft ดาวน์โหลด',
  ...Object.fromEntries(types.map(([k, name]) => [`/${k}/`, `หน้ารวม ${name}`])),
  ...Object.fromEntries((await getCollection('projects')).map((p) => [`/projects/${p.id}/`, `Project: ${p.data.name}`])),
};
---
<Base title="สถิติการเข้าชม" description="ยอดเข้าชมของแต่ละบทความบน DOJOJIN.TECH" noindex>
  <section class="hero">
    <div class="wrap" style="grid-template-columns:1fr">
      <div class="hero__text">
        <h1>สถิติการเข้าชม</h1>
        <p class="meta">นับ 1 ครั้งต่อ 1 session ต่อหน้า · เปิดหน้านี้ไม่เพิ่มยอด</p>
        <form class="search" role="search">
          <svg class="icon" aria-hidden="true"><use href="#icon-search" /></svg>
          <input type="search" placeholder="ค้นหาชื่อบทความ" aria-label="ค้นหาชื่อบทความ" autocomplete="off" />
        </form>
        <p class="stats__self">
          <button type="button" class="stats__btn" data-nocount></button>
          <span class="meta">เปิดบทความจากเครื่องนี้แล้วไม่ต้องการให้นับยอด กดปุ่มนี้ครั้งเดียวต่อ browser</span>
        </p>
      </div>
    </div>
  </section>
  <main class="wrap layout" style="grid-template-columns:1fr">
    <div class="content stats">
      <div class="stats__totals">
        <p><span>ผู้เยี่ยมชม</span><b data-total-visitors>–</b></p>
        <p><span>ยอดวิวรวม</span><b data-total-views>–</b></p>
        <p><span>จำนวนหน้า</span><b data-total-pages>–</b></p>
      </div>
      <section class="stats__mix" aria-labelledby="mix-h">
        <div class="stats__mixhead">
          <h2 id="mix-h">ผู้อ่านมาจากไหน</h2>
          <div class="filters" data-range>
            <button type="button" aria-pressed="false" data-range="1">วันนี้</button>
            <button type="button" aria-pressed="true" data-range="7">7 วัน</button>
            <button type="button" aria-pressed="false" data-range="30">30 วัน</button>
          </div>
        </div>
        <p class="meta" data-mix-note>นับ 1 ครั้งต่อการเข้าเว็บ (session) · เริ่มเก็บ 16 พ.ย. 2569 · ประเทศดูใน Cloudflare Web Analytics</p>
        <div class="stats__groups" data-mix></div>
      </section>
      <div class="filters" data-types>
        <button type="button" aria-pressed="true" data-type="">ทั้งหมด</button>
        {types.map(([k, name]) => <button type="button" aria-pressed="false" data-type={k}>{name}</button>)}
        <button type="button" aria-pressed="false" data-type="other">หน้าอื่น</button>
      </div>
      <div class="filters" data-sort>
        <button type="button" aria-pressed="true" data-sort="views">เรียงตามยอดวิว</button>
        <button type="button" aria-pressed="false" data-sort="date">เรียงตามวันที่ลง</button>
      </div>
      <ol class="stats__list" data-list aria-live="polite"><li class="stats__loading">กำลังโหลด…</li></ol>
    </div>
  </main>
</Base>

<script is:inline define:vars={{ posts, types, names }}>window.__stats = { posts, types, names };</script>
<script>
  import { firebaseConfig } from '../firebase-config.js';
  import { LABELS } from '../lib/ua.js';
  const { projectId, apiKey } = firebaseConfig;
  const api = `https://firestore.googleapis.com/v1/projects/${projectId}/databases/(default)/documents`;
  const { posts, types, names } = window.__stats;
  const typeName = Object.fromEntries(types);
  const fmt = (n) => Number(n).toLocaleString('th-TH');
  const $ = (s) => document.querySelector(s);
  const state = { type: '', sort: 'views', q: '' };
  let rows = [];

  const NOCOUNT = 'dojojin_nocount';
  const nocountBtn = $('[data-nocount]');
  const isOff = () => { try { return localStorage.getItem(NOCOUNT) === '1'; } catch { return false; } };
  const paintBtn = () => { nocountBtn.textContent = isOff() ? 'เครื่องนี้ไม่ถูกนับแล้ว · กดเพื่อกลับมานับ' : 'ไม่นับยอดจากเครื่องนี้'; nocountBtn.setAttribute('aria-pressed', String(isOff())); };
  nocountBtn.addEventListener('click', () => { try { isOff() ? localStorage.removeItem(NOCOUNT) : localStorage.setItem(NOCOUNT, '1'); } catch {} paintBtn(); });
  paintBtn();

  const render = () => {
    const words = state.q.toLowerCase().split(/\s+/).filter(Boolean);
    const list = rows
      .filter((r) => !state.type || r.type === state.type)
      .filter((r) => words.every((w) => (r.title + ' ' + r.href).toLowerCase().includes(w)))
      .sort((a, b) => (state.sort === 'date' ? (b.date ?? 0) - (a.date ?? 0) : b.n - a.n));
    const ol = $('[data-list]');
    ol.replaceChildren(...list.map((r) => {
      const li = document.createElement('li'), a = document.createElement('a'), meta = document.createElement('span'), n = document.createElement('b');
      a.href = r.href; a.textContent = r.title;
      meta.className = 'meta';
      meta.textContent = [typeName[r.type] ?? 'หน้าอื่น', r.date && new Date(r.date).toLocaleDateString('th-TH', { dateStyle: 'medium' })].filter(Boolean).join(' · ');
      n.textContent = fmt(r.n);
      const t = document.createElement('div'); t.append(a, meta);
      li.append(t, n); return li;
    }));
    if (!list.length) { const li = document.createElement('li'); li.className = 'stats__loading'; li.textContent = 'ไม่พบหน้าที่ตรงกับเงื่อนไข'; ol.append(li); }
    $('[data-total-views]').textContent = fmt(list.reduce((s, r) => s + r.n, 0));
    $('[data-total-pages]').textContent = fmt(list.length);
  };

  const pick = (group, key) => document.querySelector(group).addEventListener('click', (e) => {
    const b = e.target.closest('button'); if (!b) return;
    for (const x of e.currentTarget.querySelectorAll('button')) x.setAttribute('aria-pressed', String(x === b));
    state[key] = b.dataset[key]; render();
  });
  pick('[data-types]', 'type');
  pick('[data-sort]', 'sort');
  const input = $('.search input');
  input.addEventListener('input', () => { state.q = input.value; render(); });
  $('.search').addEventListener('submit', (e) => e.preventDefault());

  // Visit breakdown (uadaily/{yyyymmdd}__{dim}__{key}): last 30 Bangkok days fetched once, summed per chosen range.
  const GROUPS = [['ref', 'แหล่งที่มา'], ['app', 'แอปที่เปิด'], ['device', 'อุปกรณ์'], ['os', 'ระบบปฏิบัติการ'], ['browser', 'เบราว์เซอร์']];
  const bkk = (offsetDays) => new Date(Date.now() + 7 * 3600e3 - offsetDays * 864e5).toISOString().slice(0, 10).replace(/-/g, '');
  let mix = [], range = 7;
  const renderMix = () => {
    const from = bkk(range - 1);
    const sums = {};
    for (const m of mix) if (m.day >= from) (sums[m.dim] ??= {})[m.key] = (sums[m.dim][m.key] ?? 0) + m.n;
    const box = $('[data-mix]');
    if (!Object.keys(sums).length) { const p = document.createElement('p'); p.className = 'meta'; p.textContent = 'ยังไม่มีข้อมูลในช่วงนี้'; box.replaceChildren(p); return; }
    box.replaceChildren(...GROUPS.map(([dim, title]) => {
      const rows = Object.entries(sums[dim] ?? {}).sort((a, b) => b[1] - a[1]);
      const max = rows[0]?.[1] ?? 1;
      const g = document.createElement('div'); g.className = 'stats__group';
      const h = document.createElement('h3'); h.textContent = title; g.append(h);
      for (const [key, n] of rows) {
        const r = document.createElement('p'), l = document.createElement('span'), bar = document.createElement('i'), v = document.createElement('b');
        l.textContent = LABELS[dim]?.[key] ?? key; bar.style.setProperty('--w', `${(n / max) * 100}%`); v.textContent = fmt(n);
        r.append(l, bar, v); g.append(r);
      }
      return g;
    }));
  };
  document.querySelector('[data-range]').addEventListener('click', (e) => {
    const b = e.target.closest('button'); if (!b) return;
    for (const x of e.currentTarget.querySelectorAll('button')) x.setAttribute('aria-pressed', String(x === b));
    range = Number(b.dataset.range); renderMix();
  });
  fetch(`${api}:runQuery?key=${apiKey}`, { method: 'POST', body: JSON.stringify({ structuredQuery: { from: [{ collectionId: 'uadaily' }],
    where: { fieldFilter: { field: { fieldPath: '__name__' }, op: 'GREATER_THAN_OR_EQUAL', value: { referenceValue: `projects/${projectId}/databases/(default)/documents/uadaily/${bkk(29)}` } } } } }) })
    .then((r) => (r.ok ? r.json() : [])).catch(() => [])
    .then((rows) => {
      mix = rows.filter((r) => r.document).map((r) => { const [day, dim, key] = r.document.name.split('/').pop().split('__'); return { day, dim, key, n: Number(r.document.fields?.count?.integerValue ?? 0) }; });
      renderMix();
    });

  (async () => {
    const [docs, visitors] = await Promise.all([
      fetch(`${api}:runQuery?key=${apiKey}`, { method: 'POST', body: JSON.stringify({ structuredQuery: { from: [{ collectionId: 'pageviews' }] } }) })
        .then((r) => (r.ok ? r.json() : [])).catch(() => []),
      fetch(`${api}/meta/visitors?key=${apiKey}`).then((r) => (r.ok ? r.json() : null)).catch(() => null),
    ]);
    const views = new Map(docs.filter((d) => d.document).map((d) => {
      const id = d.document.name.split('/').pop();
      return [id === 'home' ? '/' : '/' + id.replace(/__/g, '/') + '/', Number(d.document.fields?.count?.integerValue ?? 0)];
    }));
    const known = new Set(posts.map((p) => p.href));
    rows = [
      ...posts.map((p) => ({ ...p, n: views.get(p.href) ?? 0 })),
      ...[...views].filter(([href]) => !known.has(href)).map(([href, n]) => ({ href, title: names[href] ?? href, type: 'other', date: null, n })),
    ];
    if (visitors?.fields?.count) $('[data-total-visitors]').textContent = fmt(visitors.fields.count.integerValue);
    if (!docs.length) { $('[data-list]').firstElementChild.textContent = 'โหลดข้อมูลไม่สำเร็จ ลองรีเฟรชอีกครั้ง'; return; }
    render();
  })();
</script>
