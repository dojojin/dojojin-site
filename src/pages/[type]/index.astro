---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { TYPES, TOPICS, NEWS_CHIPS } from '../../data/site.js';
import { getFeed } from '../../lib/feed.js';

// One page per menu section (Review / ความรู้ / Data).
export function getStaticPaths() {
  return Object.keys(TYPES).map((type) => ({ params: { type } }));
}
const { type } = Astro.params;
const t = TYPES[type];
const items = await getFeed(type);
// Filter chips: news by NEWS_CHIPS (a card can match several), every other section by category.
const [key, names] = type === 'news' ? ['news', NEWS_CHIPS] : ['topic', TOPICS];
const has = (i, k) => [].concat(i[key] ?? []).includes(k);
const chips = Object.keys(names).filter((k) => type === 'news' || items.some((i) => has(i, k)));
---
<Base title={t.name} description={`${t.blurb} · รวมทุกบทความในหมวด ${t.name} ของ DOJOJIN.TECH`} active={type}>
  <section class="hero">
    <div class="wrap" style="grid-template-columns:1fr">
      <div class="hero__text">
        <span class="kicker">{t.name}</span>
        <h1>{t.name}</h1>
        <p class="lead">{t.blurb}</p>
        {type === 'review' && <p class="hero-links"><a href="/compare/headphones/">เทียบหูฟังทุกตัวที่รีวิว →</a><a href="/compare/chargers/">เทียบหัวชาร์จทุกตัว →</a><a href="/search/">ค้นหา →</a></p>}
      </div>
    </div>
  </section>
  <main class="wrap layout" style="grid-template-columns:1fr">
    <div class="content">
      {items.length === 0 && <p class="empty">ยังไม่มีบทความในหมวดนี้</p>}
      {chips.length > 1 && (
        <div class="filters" role="group" aria-label="กรองตามหัวข้อ" data-key={key}>
          <button type="button" aria-pressed="true" data-filter="">ทั้งหมด <span>{items.length}</span></button>
          {chips.map((k) => <button type="button" aria-pressed="false" data-filter={k}>{names[k].name ?? names[k]} <span>{items.filter((i) => has(i, k)).length}</span></button>)}
        </div>
      )}
      <div class="gallery">{items.map((i) => <PostCard item={i} />)}</div>
      <p class="more" hidden><button type="button" data-more></button></p>
    </div>
  </main>
</Base>

<script>
  // Filter chips + "ดูเพิ่ม": first PAGE matching cards, then PAGE more per click; a new filter starts over.
  // ponytail: all cards stay in the HTML (covers are lazy), split into /page/N/ URLs if a section passes a few hundred posts.
  const PAGE = 12;
  const btns = document.querySelectorAll('[data-filter]');
  const key = document.querySelector('.filters')?.dataset.key;
  const cards = [...document.querySelectorAll('.gallery > .post-card')];
  const more = document.querySelector('[data-more]');
  let filter = '', shown = PAGE;
  const render = () => {
    const match = cards.filter((c) => !filter || (c.dataset[key] ?? '').split(' ').includes(filter));
    cards.forEach((c) => { c.hidden = true; });
    match.slice(0, shown).forEach((c) => { c.hidden = false; });
    const left = match.length - shown;
    more.parentElement.hidden = left <= 0;
    more.textContent = `ดูเพิ่มอีก ${Math.min(PAGE, left)} รายการ (เหลือ ${left})`;
  };
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    filter = b.dataset.filter; shown = PAGE; render();
  }));
  more.addEventListener('click', () => { shown += PAGE; render(); });
  render();
</script>
