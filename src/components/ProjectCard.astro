---
// One project card (src/content/projects). Status is shown as text + colour, never colour alone.
const { project } = Astro.props;
const p = project.data;
const STATUS = { LIVE: 1, BETA: 2, INTERNAL: 3, PAUSED: 4 };
---
<a class="grade-card project" href={`/projects/${project.id}/`}>
  <div class="project__head">
    <h3>{p.icon && <img src={p.icon} width="28" height="28" alt="" class="project__icon" />}{p.name}</h3>
    <span class={`badge tier-${STATUS[p.status]}`}><svg class="icon" aria-hidden="true"><use href="#icon-dot" /></svg>{p.status}</span>
  </div>
  <p>{p.summary}</p>
  <span class="more">ดูโปรเจกต์ <svg class="icon" aria-hidden="true"><use href="#icon-next" /></svg></span>
</a>
