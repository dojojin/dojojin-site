rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in ['dojojin@gmail.com'];
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'msg', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.msg is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.msg.size() > 0
        && request.resource.data.msg.size() <= 300;
      allow update: if false;
      allow delete: if isOwner();
    }

    // Counters: anyone may add exactly 1 — never set, reset or jump the number.
    function countOnly() {
      return request.resource.data.keys().hasOnly(['count']) && request.resource.data.count is int;
    }

    match /meta/visitors {
      allow read: if true;
      allow create: if countOnly() && request.resource.data.count == 1;
      allow update: if countOnly() && request.resource.data.count == resource.data.count + 1;
    }

    // One doc per page path ("review__oppo-enco-x3s", "home"), incremented once per session.
    match /pageviews/{pageId} {
      allow read: if true;
      allow create: if pageId.matches('^[A-Za-z0-9_.-]{1,120}$') && countOnly() && request.resource.data.count == 1;
      allow update: if countOnly() && request.resource.data.count == resource.data.count + 1;
    }

    // Daily visit breakdown, one doc per Bangkok date + dimension + value ("20261116__app__facebook"),
    // +1 once per browser session. KEEP IN SYNC with src/lib/ua.js (scripts/ua-check.mjs checks it).
    match /uadaily/{docId} {
      allow read: if true;
      allow create: if docId.matches('^20[0-9]{6}__(app__(none|line|messenger|facebook|instagram|tiktok|telegram|whatsapp|wechat|outlook|teams|slack)|browser__(edge|samsung|opera|firefox|chrome|safari|inapp|other)|os__(ios|android|windows|macos|chromeos|linux|other)|device__(mobile|tablet|desktop|other)|ref__(direct|facebook|google|line|bing|x|youtube|pantip|internal|other))$')
        && countOnly() && request.resource.data.count == 1;
      allow update: if countOnly() && request.resource.data.count == resource.data.count + 1;
    }

    // Daily snapshot of all pageview counts, written by the scheduled job (service account bypasses rules).
    match /snapshots/{day} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
