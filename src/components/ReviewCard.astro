---
// Card linking to one review (used on review listings and the home page).
const { review, sub } = Astro.props;
const d = review.data;
---
<a class="shot" href={`/reviews/${review.id}/`}>
  <div class="shot__img"><img src={d.cover} width="1600" height="1200" loading="lazy" alt="" /></div>
  <div class="shot__body">
    <div class="shot__label">{d.title}</div>
    <span class="meta">{sub ?? d.description}</span>
  </div>
</a>
