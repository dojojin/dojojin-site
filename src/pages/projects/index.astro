---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { PROFILE, EXPERIENCES } from '../../data/site.js';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Projects" description={`${PROFILE.name} (${PROFILE.handle}) — ${PROFILE.intro}`} active="projects">
  <section class="hero">
    <div class="wrap" style="grid-template-columns:1fr">
      <div class="hero__text">
        <span class="kicker">Projects · {PROFILE.handle}</span>
        <h1>{PROFILE.name}</h1>
        <p class="lead">{PROFILE.intro}</p>
        <ul class="socials">
          <li><a href={`mailto:${PROFILE.email}`}>ติดต่อ</a></li>
          {Object.entries(PROFILE.socials).map(([k, v]) => <li><a href={v} rel="noopener">{k[0].toUpperCase() + k.slice(1)}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <main class="wrap layout" style="grid-template-columns:1fr">
    <div class="content">
      <section class="section">
        <h2>ผลงาน</h2>
        <div class="grade-grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
      </section>

      <section class="section">
        <h2>ประสบการณ์</h2>
        <ol class="timeline grade-grid">
          {EXPERIENCES.map((e) => (
            <li class="grade-card">
              <h3>{e.role}<small>{e.period}</small></h3>
              <ul>{e.items.map((it) => <li>{it}</li>)}</ul>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </main>
</Base>
