---
import '../styles/site.css';
import Icons from '../components/Icons.astro';
import ViewCounter from '../components/ViewCounter.astro';
import { EasterEggs } from '../App.jsx';
import { PROFILE, NAV, SITE } from '../data/site.js';

const {
  title,
  description = SITE.description,
  image = '/og-image.png',
  active,
  ogType = 'website',
  schema = [],      // extra JSON-LD nodes for this page (BlogPosting, BreadcrumbList, …)
  noindex = false,  // thin pages (404, single-post tags) stay out of search results
} = Astro.props;

const siteName = 'DOJOJIN.TECH';
const fullTitle = title ? `${title} — ${siteName}` : `${siteName} — ${SITE.tagline}`;
const ogTitle = title ?? fullTitle;
const url = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const nav = NAV;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: PROFILE.name,
      alternateName: 'Mr. Dojo-mAn',
      url: 'https://dojojin.tech/',
      jobTitle: 'System Engineer / Infrastructure Engineer',
      description: 'System Engineer สาย CCTV analytics, computer vision, real-time event systems และ infrastructure',
      knowsAbout: ['CCTV', 'Computer Vision', 'Infrastructure', 'Self-hosted AI', 'Photography', 'Consumer electronics'],
      sameAs: Object.values(PROFILE.socials).map((u) => u.replace(/\/$/, '')),
    },
    {
      '@type': 'WebSite',
      name: siteName,
      url: 'https://dojojin.tech/',
      inLanguage: 'th',
      author: { '@type': 'Person', name: PROFILE.name },
    },
    ...schema,
  ],
};
---
<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0f1218" media="(prefers-color-scheme: dark)" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Mr. Dojo-mAn (Prakasit)" />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
  <link rel="canonical" href={url} />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:locale" content="th_TH" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <script is:inline>
    // Theme before first paint: saved choice, else the device setting (no flash of the wrong theme).
    (() => { let t; try { t = localStorage.getItem('theme'); } catch {}
      document.documentElement.dataset.theme = t || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;600;700&family=JetBrains+Mono:wght@500;600&display=swap" />
</head>
<body>
  <Icons />
  <header class="site-bar">
    <div class="wrap">
      <span class="brand">
        <button class="brand__logo" type="button" data-logo aria-label="DOJOJIN logo"><img src="/logo.png" alt="" width="28" height="28" /></button>
        <a class="site-bar__brand" href="/">{siteName}</a>
      </span>
      <span class="site-tools">
        <span class="site-visitors" data-visitors hidden title="ผู้เข้าชมเว็บทั้งหมด"><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg><b></b><span class="hide-sm"> visitors</span></span>
        <a class="tool-btn" href="/search/" aria-label="ค้นหา" title="ค้นหา"><svg class="icon" aria-hidden="true"><use href="#icon-search" /></svg></a>
        <button class="tool-btn" type="button" data-theme-toggle aria-label="สลับโหมดมืด/สว่าง" title="สลับโหมดมืด/สว่าง"><svg class="icon icon--dark" aria-hidden="true"><use href="#icon-moon" /></svg><svg class="icon icon--light" aria-hidden="true"><use href="#icon-sun" /></svg></button>
      </span>
      <nav class="site-nav" aria-label="เมนูหลัก">
        {nav.map(([id, href, label]) => <a href={href} aria-current={active === id ? 'page' : undefined}>{label}</a>)}
      </nav>
    </div>
  </header>

  <slot />
  <script is:inline>
    (() => {
      const root = document.documentElement, mq = matchMedia('(prefers-color-scheme: dark)');
      const saved = () => { try { return localStorage.getItem('theme'); } catch { return null; } };
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const t = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = t; try { localStorage.setItem('theme', t); } catch {}
      });
      mq.addEventListener('change', (e) => { if (!saved()) root.dataset.theme = e.matches ? 'dark' : 'light'; });
    })();
  </script>

  <footer class="source site-footer">
    <div class="wrap">
      <span>© {new Date().getFullYear()} {siteName} · {PROFILE.name}</span>
      <span><a href="/tag/">Tags</a> · <a href="/lab/">/lab</a></span>
    </div>
  </footer>
  <EasterEggs client:only="react" />
  <ViewCounter />
</body>
</html>
