rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in ['dojojin@gmail.com'];
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'msg', 'ts'])
        && request.resource.data.name is string
        && request.resource.data.msg is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.msg.size() > 0
        && request.resource.data.msg.size() <= 300;
      allow update: if false;
      allow delete: if isOwner();
    }

    // Counters: anyone may add exactly 1 — never set, reset or jump the number.
    function countOnly() {
      return request.resource.data.keys().hasOnly(['count']) && request.resource.data.count is int;
    }

    match /meta/visitors {
      allow read: if true;
      allow create: if countOnly() && request.resource.data.count == 1;
      allow update: if countOnly() && request.resource.data.count == resource.data.count + 1;
    }

    // One doc per page path ("review__oppo-enco-x3s", "home"), incremented once per session.
    match /pageviews/{pageId} {
      allow read: if true;
      allow create: if pageId.matches('^[A-Za-z0-9_.-]{1,120}$') && countOnly() && request.resource.data.count == 1;
      allow update: if countOnly() && request.resource.data.count == resource.data.count + 1;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
