---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { SITE, TYPES, PROFILE } from '../data/site.js';
import { getFeed } from '../lib/feed.js';

const feed = await getFeed();
// One section per menu type, same order as the menu; empty types are skipped.
const sections = Object.entries(TYPES).map(([type, t]) => ({ type, t, items: feed.filter((i) => i.type === type) })).filter((s) => s.items.length);
// Home shows 3 cards per type, mixed across categories: newest of each topic first (feed is newest-first),
// then the rest by date — so one busy category (e.g. chargers) can't fill the whole row.
const mixed = (items, n = 3) => {
  const seen = new Set(), picks = [];
  for (const i of items) if (!seen.has(i.topic)) { seen.add(i.topic); picks.push(i); }
  return [...picks, ...items.filter((i) => !picks.includes(i))].slice(0, n).sort((a, b) => b.date - a.date);
};
// Titles for the client-side "ยอดนิยม" box (filled from Firestore page views by ViewCounter).
const titles = Object.fromEntries(feed.map((i) => [i.href, i.title]));
---
<Base active="home">
  <section class="hero">
    <div class="wrap home-hero">
      <div class="hero__text">
        <span class="kicker">{SITE.name}</span>
        <h1>{SITE.tagline}</h1>
        <p class="lead">{SITE.description}</p>
        <ul class="pillars">
          {Object.entries(TYPES).map(([type, t]) => (
            <li><a href={`/${type}/`}><b>{t.name} <span>{feed.filter((i) => i.type === type).length}</span></b><span>{t.blurb}</span></a></li>
          ))}
        </ul>
      </div>
      <aside class="author-card" aria-label="ผู้เขียน">
        <div class="author-card__head">
          <img src="/favicon.svg" width="56" height="56" alt="" />
          <div><b>{PROFILE.handle}</b><span>{PROFILE.name}</span></div>
        </div>
        <p>{PROFILE.intro}</p>
        <p>เว็บนี้คือที่เก็บสิ่งที่ผมลองเอง วัดเอง และอยากเล่าให้คนอื่นเข้าใจง่าย ๆ ทุกตัวเลขมีที่มา และทุกรูปบอกที่มาชัดเจน</p>
        <ul class="socials">
          <li><a href="/projects/">ผลงานของผม</a></li>
          <li><a href={`mailto:${PROFILE.email}`}>ติดต่อ</a></li>
          <li><a href={PROFILE.socials.facebook} rel="noopener">Facebook</a></li>
        </ul>
        <p class="visitors" data-visitors hidden>ผู้เข้าชมเว็บ <b></b> ครั้ง</p>
        <div class="popular" data-popular={JSON.stringify(titles)} hidden>
          <b>ยอดนิยม</b>
          <ol></ol>
        </div>
      </aside>
    </div>
  </section>

  <main class="wrap layout" style="grid-template-columns:1fr">
    <div class="content">
      {sections.map(({ type, t, items }) => (
        <section class="section">
          <div class="section-head">
            <h2>{t.name}</h2>
            <a class="more" href={`/${type}/`}>ดูทั้งหมด ({items.length}) <svg class="icon" aria-hidden="true"><use href="#icon-next" /></svg></a>
          </div>
          <p class="meta" style="margin:0 0 var(--space-2)">{t.blurb}</p>
          <div class="gallery">{mixed(items).map((i) => <PostCard item={i} />)}</div>
        </section>
      ))}

    </div>
  </main>
</Base>
